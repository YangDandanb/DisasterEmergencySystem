# ===== 大文件（不进 git，GitHub/Gitee 单文件限 100MB）=====
*.tif
*.aux.xml

# ===== Python =====
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ===== Node（前端另有自己的 .gitignore，这里兜底）=====
node_modules/
dist/
dist-ssr/
*.local

# ===== 密钥 / 环境变量（绝不提交）=====
.env
.env.local
.env.*.local

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== 日志 =====
*.log
npm-debug.log*
